def minimax(tree, depth, maximizing):
    if depth == 0:
        return tree

    if maximizing:
        return max(
            minimax(x, depth - 1, False) for x in tree
        )
    else:
        return min(
            minimax(x, depth - 1, True) for x in tree
        )

tree = [[3, 5], [2, 9]]

print("Best Value:", minimax(tree, 2, True))
