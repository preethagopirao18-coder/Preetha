import heapq

def greedy_search(graph, heuristic, start, goal):
    pq = [(heuristic[start], start)]
    visited = set()
    parent = {}

    while pq:
        _, node = heapq.heappop(pq)

        if node in visited:
            continue

        visited.add(node)

        if node == goal:
            path = []
            while node:
                path.append(node)
                node = parent.get(node)
            return path[::-1]

        for neighbour in graph[node]:
            if neighbour not in visited:
                parent[neighbour] = node
                heapq.heappush(
                    pq, (heuristic[neighbour], neighbour)
                )

graph = {
    'A': ['B', 'C'],
    'B': ['D'],
    'C': ['E'],
    'D': ['F'],
    'E': ['F'],
    'F': []
}

heuristic = {
    'A': 6, 'B': 4, 'C': 2,
    'D': 3, 'E': 1, 'F': 0
}

print("Path:", greedy_search(graph, heuristic, 'A', 'F'))
